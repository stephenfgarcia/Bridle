# Bridle local defaults (card P0-02.2). Nothing here is a secret: these are the docker compose dev
# defaults, committed on purpose. Real secrets live in .env.local (gitignored; docs/ops/secrets.md),
# which compose never reads. Format: comments on their own lines, every other line KEY=value with no
# quotes, spaces or ${}: compose's env_file and bash's `.` both read this file (tools/dev.sh).
BRIDLE_ENV=local

# Postgres (service postgres; container port 5432 published on host port 55432 because a Homebrew
# postgresql@16 listens on 5432 on the development machine)
POSTGRES_USER=bridle
POSTGRES_PASSWORD=bridle
POSTGRES_DB=bridle
DATABASE_URL=postgresql://bridle:bridle@127.0.0.1:55432/bridle

# Object storage (service minio, S3-compatible; the RUSTFS_* pair must equal the S3_* pair)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=bridle-dev
S3_ACCESS_KEY_ID=bridle
S3_SECRET_ACCESS_KEY=bridle-local
RUSTFS_ACCESS_KEY=bridle
RUSTFS_SECRET_KEY=bridle-local

# Mail (service mailpit: SMTP sink and web UI)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_URL=http://127.0.0.1:8025
