{
  "name": "bridle",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "check": "bash tools/check.sh",
    "lint": "biome ci .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "fmt": "biome check --write . && cargo fmt --all",
    "dev": "bash tools/dev.sh up",
    "dev:down": "bash tools/dev.sh down",
    "dev:reset": "bash tools/dev.sh reset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "turbo": "2.11.10"
  }
}
