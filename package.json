{
  "name": "bridle",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "check": "bash tools/check.sh",
    "lint": "biome ci . && node packages/i18n/lint/lint-strings.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e:smoke": "playwright test",
    "i18n:pseudo": "pnpm --filter @bridle/i18n pseudo",
    "fmt": "biome check --write . && cargo fmt --all",
    "dev": "bash tools/dev.sh up",
    "dev:down": "bash tools/dev.sh down",
    "dev:reset": "bash tools/dev.sh reset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "turbo": "2.11.10"
  }
}
