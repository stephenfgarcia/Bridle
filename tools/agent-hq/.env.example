# Browser (Vite exposes VITE_* to the client). The anon key is public by design: the database
# policies make it read-only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...
# Optional: which project row to show (default: the oldest). The seed creates "q4-launch".
VITE_PROJECT_ID=q4-launch

# API server only. Never ship these to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role...
# Secret your agents send as `x-api-key`. Generate one: openssl rand -hex 32
AGENT_HQ_API_KEY=change-me
PORT=8787
HOST=127.0.0.1
