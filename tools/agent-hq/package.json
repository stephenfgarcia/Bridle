{
  "name": "agent-hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent HQ: an animated neon-night office showing what every AI agent is working on",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/seed.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "biome ci .",
    "fmt": "biome check --write ."
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@supabase/supabase-js": "2.118.0",
    "maath": "0.10.8",
    "motion": "14.9.0",
    "postprocessing": "6.37.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
